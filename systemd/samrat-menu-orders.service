[Unit]
Description=Samrat Menu Orders (app server)
After=network-online.target

[Service]
WorkingDirectory=/home/savant/projects/samrat-menu-orders
EnvironmentFile=/home/savant/projects/samrat-menu-orders/.env
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
